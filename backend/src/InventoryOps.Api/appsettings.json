{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.Extensions.Diagnostics.HealthChecks": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "",
    "Redis": ""
  },
  "Security": {
    "RequireHttpsCookies": true
  },
  "OpenApi": {
    "Enabled": false
  },
  "RateLimiting": {
    "LoginPermitsPerMinute": 10,
    "ApiPermitsPerMinute": 600
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/"
  },
  "Outbox": {
    "BatchSize": 50,
    "MaxAttempts": 10
  }
}
