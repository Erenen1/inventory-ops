# Copy-free setup: run scripts/bootstrap.sh (Linux/macOS/WSL) or scripts/bootstrap.ps1 (Windows),
# which creates .env from this template and fills every <generated> value with a random secret.
# .env is git-ignored. Never commit real credentials.

# SQL Server (Developer Edition, local only)
SQL_SA_PASSWORD=<generated>
SQL_APP_PASSWORD=<generated>

# Redis / RabbitMQ
REDIS_PASSWORD=<generated>
RABBITMQ_PASSWORD=<generated>

# First administrator (created once by the migrator if the email does not exist yet)
ADMIN_EMAIL=admin@inventoryops.local
ADMIN_PASSWORD=<generated>

# Demo data and demo users for local development only. Leave false for any shared environment.
SEED_DEMO_DATA=true
DEMO_MANAGER_EMAIL=manager@inventoryops.local
DEMO_MANAGER_PASSWORD=<generated>
DEMO_VIEWER_EMAIL=viewer@inventoryops.local
DEMO_VIEWER_PASSWORD=<generated>

# Frontend binding (loopback by default)
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# Set to true when the stack is served over HTTPS (Secure cookies)
REQUIRE_HTTPS_COOKIES=false
OPENAPI_ENABLED=true
